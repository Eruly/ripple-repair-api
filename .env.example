# OpenAI-compatible Chat Completions (vLLM, llama.cpp, OpenAI, ...)
OPENAI_BASE_URL=http://127.0.0.1:30000/v1
# Local servers that do not require auth can leave this empty.
# OPENAI_API_KEY=EMPTY
OPENAI_MODEL=Qwen/Qwen3.8-27B-FP8
QWEN_MODEL=Qwen/Qwen3.8-27B-FP8

# FactReasoner (defaults to OPENAI_* when unset)
# FACTREASONER_BASE_URL=http://127.0.0.1:30000/v1
# FACTREASONER_MODEL=Qwen/Qwen3.8-27B-FP8
# FACTREASONER_API_KEY=EMPTY
# Qwen3.x / GLM thinking off for structured JSON (recommended). Set 1 to enable.
# FACTREASONER_ENABLE_THINKING=
# FACTREASONER_GRAPH_MODEL=
# FACTREASONER_JUDGE_MODEL=
# FACTREASONER_CORRECTION_MODEL=
# FACTREASONER_REVIEW_MODEL=

# Fast NLI pair mining (optional extra: uv sync --extra fast)
# FACTREASONER_NLI_MODE=fast
# FACTREASONER_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# FACTREASONER_EMBEDDING_BACKEND=sentence-transformers
# FACTREASONER_EMBEDDING_CACHE_DIR=.cache/embeddings
# FACTREASONER_EMBEDDING_DEVICE=cpu
# FACTREASONER_NLI_CACHE_PATH=.cache/factreasoner/nli.sqlite3

WEB_APP_HOST=0.0.0.0
WEB_APP_PORT=8200
